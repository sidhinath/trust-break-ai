# ==============================================================================
# GhostNet AI - Environment Configuration Matrix
# ==============================================================================
# IMPORTANT:
# - Variables starting with VITE_ are bundled into client-side JS (CLIENT SAFE).
# - Variables WITHOUT VITE_ are used exclusively in Vercel serverless functions (SERVER ONLY).
# - NEVER put sensitive API keys or service role secrets into VITE_ variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE CONFIGURATION (CLIENT SAFE / PUBLIC)
# ------------------------------------------------------------------------------
# Hosted Supabase project URL used by frontend for public blocklist reads & auth.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Anonymous / Public API Key. Safe for browser distribution.
VITE_SUPABASE_ANON_KEY="your-supabase-public-anon-key-placeholder"

# Firebase Authentication Web Configuration (CLIENT SAFE)
VITE_FIREBASE_API_KEY="your-firebase-api-key-placeholder"
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project"
VITE_FIREBASE_STORAGE_BUCKET="your-firebase-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
VITE_FIREBASE_MEASUREMENT_ID="G-YOURMEASUREMENTID"

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE CREDENTIALS (SERVER ONLY - NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# Primary Google Gemini AI key used in api/analyze.js for deep multimodal threat analysis.
GEMINI_API_KEY="your-gemini-api-key-placeholder"

# Supabase connection URL for Vercel serverless API routes.
SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Anonymous key for serverless read operations (least-privilege).
SUPABASE_ANON_KEY="your-supabase-public-anon-key-placeholder"

# Supabase Service Role Key (CRITICAL SENSITIVITY).
# Used strictly by server-side cron jobs and threat-feed ingestion for batch upserts.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-placeholder"

# Secret Bearer token for authenticating Vercel Cron requests to /api/cron/sync-feeds.
CRON_SECRET="your-high-entropy-random-secret-token"

# Optional: Groq API key for lightning-fast speech-to-text transcription (Whisper-large-v3).
GROQ_API_KEY="your-groq-api-key-placeholder"

# Optional: OpenAI API key fallback for speech transcription and analysis.
OPENAI_API_KEY="your-openai-api-key-placeholder"

# Server-Side TinyFish Web Automation API Key (SERVER ONLY - NEVER EXPOSE TO CLIENT)
TINYFISH_API_KEY="your-tinyfish-api-key-placeholder"

# ------------------------------------------------------------------------------
# 3. FEATURE FLAGS (SERVER & RUNTIME CONTROL)
# ------------------------------------------------------------------------------
# Toggle for Voice & Deepfake Scanner endpoint (/api/analyze-voice).
ENABLE_VOICE_SCANNER="true"

# Toggle for Browser Shield Pre-Click Interceptor endpoint (/api/blocklist-lite).
ENABLE_PRE_CLICK_INTERCEPTOR="true"
